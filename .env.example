# ──────────────────────────────────────────────────────────────────────────────
# Inboxora — Environment Configuration
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in the values below
# 3. Generate the TLS cert (see README) or use --profile https for Let's Encrypt
# 4. Run:              docker compose up -d --build
# ──────────────────────────────────────────────────────────────────────────────


# ── Access ────────────────────────────────────────────────────────────────────
# Port the app listens on (HTTPS). Default is 443.
APP_PORT=443

# Port the app listens on (HTTP). Default is 80.
# Use this when running behind a reverse proxy that terminates TLS upstream.
# Your proxy should forward X-Forwarded-Proto: https so session cookies work correctly.
APP_HTTP_PORT=80

# Full URL users see in the browser — used in invite emails and CORS.
APP_URL=https://your-domain-or-ip


# ── Secrets ───────────────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -hex 32
SESSION_SECRET=

# REQUIRED — generate with: openssl rand -hex 16
DB_PASSWORD=

# REQUIRED — generate with: openssl rand -hex 32
# Used to encrypt stored email credentials (passwords, OAuth tokens) at rest.
# WARNING: If this key is lost or changed, all stored credentials become unreadable
#          and users will need to re-enter passwords / re-authenticate OAuth accounts.
ENCRYPTION_KEY=


# ── OAuth providers (optional — configure in Settings → Integrations) ─────────
# The supported way to configure these is the admin UI: Settings → Integrations →
# Email providers. Values saved there are stored (secrets encrypted) and take
# precedence over this file; deleting a provider in the UI writes a tombstone so
# the values below are NOT restored on restart. Set the environment variables
# here only for a headless/automated install.
#
# Microsoft mailboxes use OAuth2: Inboxora signs in with the application below and
# then talks IMAP/SMTP with the resulting token. Register an Entra application and
# copy its Application (client) ID. The web method also needs a client secret and
# the exact redirect URI; the device-code method needs only the Client ID and
# "Allow public client flows" enabled on the app registration.
# MS_CLIENT_ID=
# MS_TENANT_ID=common
# MS_CLIENT_SECRET=
# MS_REDIRECT_URI=https://mail.example.com/oauth/microsoft/callback
# The Microsoft Graph connector authorizes on its own callback, which is derived from
# APP_URL when this is unset. It must be registered on the same Entra application.
# MS_PROVIDER_REDIRECT_URI=https://mail.example.com/oauth/provider/microsoft/callback
#
# Google APIs are recommended but optional. IMAP/SMTP with an app password keeps
# working without any of these values, so Google mail is never blocked by a
# missing Cloud project. The API integration needs a Google Cloud project with
# the Gmail, Calendar and People APIs enabled, plus a Web application OAuth
# client; Google does not offer a device-code flow for these scopes.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://mail.example.com/oauth/google/callback
# How often the server refreshes the Google contacts and calendars a user has
# already pulled. Only already-pulled collections are refreshed — connecting an
# account never starts an import by itself. 0 disables the schedule (syncs still
# run when the user asks for them); the default is 15, capped at 1440 minutes.
# PROVIDER_SYNC_INTERVAL_MINUTES=15

# ── Instant synchronisation (push-assisted sync) ───────────────────────────────
# Polling is always the safety net; push only shortens the delay. Off by default: with it off nothing is
# registered at a provider and the schedule below is the whole story.
# PROVIDER_PUSH_ENABLED=false
# The public HTTPS base a provider calls back on, derived from APP_URL (set APP_URL first; a provider will
# not deliver to plain HTTP, and https is required outside localhost). The webhook endpoints live under
# /api/provider-webhooks/{microsoft,gmail,google-calendar} and authenticate themselves.
# APP_URL=https://mail.example.com
# Gmail uses Cloud Pub/Sub: create a topic in the Google Cloud project, grant the Gmail service account
# (gmail-api-push@system.gserviceaccount.com) the Publisher role on it, and create a **push** subscription
# whose endpoint is https://<APP_URL>/api/provider-webhooks/gmail?token=<GOOGLE_PUBSUB_VERIFICATION_TOKEN>.
# GOOGLE_PUBSUB_TOPIC=projects/example-project/topics/inboxora-gmail-push
# Shared secret that authenticates a Pub/Sub push (at least 16 characters). Generate one with
# `openssl rand -base64 32`; it is compared constant-time and never logged or returned.
# GOOGLE_PUBSUB_VERIFICATION_TOKEN=
# How far ahead of expiry subscriptions are renewed, how often the sweep runs, and how long a burst of
# notifications is coalesced into one sync. Google watches are renewed daily by design (Google requires at
# least every 7 days); Graph subscriptions live ~3 days; Calendar channels ~6 days.
# PROVIDER_PUSH_RENEW_AHEAD_MINUTES=30
# PROVIDER_PUSH_SWEEP_MS=600000
# PROVIDER_SYNC_HINT_DEBOUNCE_MS=2000
# PROVIDER_SYNC_HINT_POLL_MS=15000

# ── Send limits (P06) ─────────────────────────────────────────────────────────
# The effective ceiling for one send is min(installation ceiling, provider ceiling, operation ceiling), and
# the provider's own numbers are defined in code (backend/src/services/providers/mailCapabilities.ts):
#   Microsoft Graph  — one file up to 150 MB through a resumable upload session (above 3 MB it stops
#                      travelling inline), whole message up to 150 MB
#   Gmail API        — the raw RFC-822 message must fit in 25 MB
#   SMTP             — no universal limit exists, so the fallback below applies
#
# FALLBACK composed-message ceiling, in bytes, used only for a transport that declares no ceiling of its own
# (SMTP). The default is Gmail's raw-message limit, the lowest an installation is likely to meet. Raising it
# raises no provider's limit, and it does not cap a provider that declares a larger one — a Graph account is
# bounded by Graph's own 150 MB, not by this number.
MAIL_MAX_MESSAGE_BYTES=26214400

# HARD installation ceiling, in bytes, on one attachment and on all attachments of one message together,
# applied to every transport whatever a provider would accept. The default is the largest file any supported
# provider carries (Graph's 150 MB), so leaving it unset does not cap Graph; set it lower to bound the whole
# installation, for example when a reverse proxy in front of Inboxora has a smaller body limit.
# MAIL_MAX_ATTACHMENT_BYTES=157286400


# ── Database & Redis (advanced — external servers) ────────────────────────────
# By default Inboxora runs its own bundled Postgres and Redis, and these are
# already wired up. Only set these to use EXISTING servers elsewhere on your
# network (e.g. on a non-standard port). If you do, stop/remove the bundled
# `postgres` and `redis` services so they don't run unused.
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=inboxora
# DB_USER=inboxora
# REDIS_URL=redis://redis:6379


# ── Storage & permissions (bind mounts / Unraid) ──────────────────────────────
# By default the Postgres and Redis data live in Docker-managed named volumes.
# To store them on a host path instead (e.g. an Unraid appdata share), point these
# at that path, create/chown it to PUID:PGID first, then set PUID/PGID so the
# containers write files as that owner. On Unraid, PUID=99 and PGID=100.
# Leaving PUID/PGID unset keeps the default (root) behaviour with named volumes.
# POSTGRES_DATA=/mnt/user/appdata/inboxora/postgres
# REDIS_DATA=/mnt/user/appdata/inboxora/redis
# PUID=99
# PGID=100


# ── Update check (optional) ───────────────────────────────────────────────────
# Inboxora asks GitHub for the latest release so the interface can show an update
# notice. Set this to 1 (or true/yes/on) to turn that check off entirely, which is
# what an air-gapped installation wants.
# UPDATE_CHECK_DISABLED=


# ── Web Push Notifications (optional) ────────────────────────────────────────
# Enables native OS / PWA push notifications for new mail.
# Generate a key pair once with:  npx web-push generate-vapid-keys
# VAPID_SUBJECT must be either a mailto: address or your APP_URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com


# ── Native Android instant notifications (built-in ntfy / UnifiedPush) ───────
# The default Docker stack runs ntfy on the SAME domain. Enter the ORIGIN in the
# ntfy Android app (it refuses a base URL that contains a path):
#   https://mail.example.com          (i.e. ${APP_URL}, without /push)
# Inboxora proxies only the UnifiedPush topic namespace ("up" + 12 random
# characters) and ntfy's /v1 API at that origin; ${APP_URL}/push remains
# available as a compatibility alias.
# The Android app (with the ntfy app installed) registers its UnifiedPush
# endpoint with this server; the server then sends only
#   {"type":"mail.changed","eventId":"<opaque id>"}
# through ntfy. Sender, subject, addresses and body are fetched from THIS server
# afterwards. No central service, no extra domain and no Firebase are required.
#
# Advanced: use your own external ntfy instead of the bundled one. Set the URL,
# then start with docker-compose.external-ntfy.yml (which disables the bundled
# ntfy service):
# PUSH_BASE_URL=https://push.example.com
#
# Allow a UnifiedPush endpoint on a private/LAN address (e.g. a LAN-only
# Inboxora served over http). Off by default: enabling it would let a logged-in
# user aim the server at internal hosts (SSRF).
# PUSH_ALLOW_PRIVATE_ENDPOINTS=false
#
# How long the bundled ntfy keeps an undelivered event, and where it stores data
# (a Docker named volume by default; set a host path to bind-mount it).
# NTFY_CACHE_DURATION=12h
# NTFY_DATA=/mnt/user/appdata/inboxora/ntfy
#
# Optional and no longer needed: the legacy FCM transport, only for Android
# builds compiled with their own Firebase project. UnifiedPush + ntfy is the
# supported default and requires none of this.
# FCM_SERVICE_ACCOUNT_JSON=


# ── Let's Encrypt (optional — only needed with --profile https) ───────────────
# Only used when running: docker compose --profile https up -d --build
# Requires a real public domain with DNS pointing at this server.
DOMAIN=mail.yourdomain.com
ACME_EMAIL=you@yourdomain.com


# ── IMAP tuning ───────────────────────────────────────────────────────────────
# Max always-on IMAP connections Inboxora keeps per provider host. Each enabled
# account normally holds one persistent (IDLE) connection, so many accounts on
# ONE mail server can exceed the server's per-user/per-IP connection limit (e.g.
# Dovecot's mail_max_userip_connections, default 10), causing sync errors and a
# snippet-indexer backoff loop. Set this to your provider's limit and Inboxora
# keeps that many accounts on live push and polls the rest on the sync interval.
# Empty or 0 = unlimited (default; unchanged behavior). Only set it if you run
# many accounts on one connection-limited server.
IMAP_MAX_PERSISTENT_PER_HOST=

# ── Calendar rendering ────────────────────────────────────────────────────────
# Recurring events are expanded into concrete occurrences before they are sent to
# the browser. That work runs on a small worker pool and the results are cached per
# event, keyed by the event's version, so an unchanged calendar is never re-expanded.
# The defaults suit a self-hosted instance; the knobs exist for a large deployment or
# a container with an unusual CPU budget.
#
# Worker threads. Default: one fewer than the available cores, capped at 4.
# CALENDAR_PROJECTION_WORKERS=
# Wall-clock limit for expanding a single event, in milliseconds (default 5000).
# CALENDAR_PROJECTION_TIMEOUT_MS=
# Occurrences one event may produce before it is reported as truncated (default 10000).
# Raise it if legitimate long-running series report themselves incomplete.
# CALENDAR_PROJECTION_MAX_ITERATIONS=
# Expanded occurrences are cached per event for the whole calendar month the requested
# window starts in, so every view of that month (the month grid, any week inside it, the
# day agenda) is served by one expansion. How long that entry stays cached, in
# milliseconds (default 30 minutes). The key includes the event's version, so an edit
# invalidates it immediately and this only bounds memory.
# CALENDAR_PROJECTION_CACHE_TTL_MS=
# How long a *failed* expansion stays cached before it is retried, in milliseconds
# (default 30 seconds). Failures are cached briefly so one pathological series cannot
# be re-expanded on every request.
# CALENDAR_PROJECTION_FAILURE_CACHE_TTL_MS=
# Extra whole months appended to a cached horizon (default 0). Raising it makes moving
# from one month to the next free instead of costing one expansion, at the cost of
# expanding more occurrences on the very first view of a month. Leave at 0 unless
# month-to-month arrowing is the dominant interaction on your instance.
# CALENDAR_PROJECTION_HORIZON_FORWARD_MONTHS=
# Set to 1 to render events on the request thread instead of the worker pool
# (diagnostics only — it makes requests slower).
# CALENDAR_PROJECTION_DISABLED=

# ── Materialised calendar occurrences ─────────────────────────────────────────
# Recurring events are expanded in the background into a table of concrete instances, so
# reading a date range is an indexed lookup instead of walking every series from its own
# start date (which cost ~50-90 ms per long-running series on every cold view). An event
# that has not been built yet is still expanded on the fly, so a lagging worker makes the
# calendar slower — never incomplete. See migration 0083.
#
# Months of history to materialise (default 3). Calendars are read forward, so this only
# needs to cover how far back people scroll.
# CALENDAR_OCCURRENCE_HORIZON_PAST_MONTHS=
# Months ahead to materialise (default 18). Navigating past it stays correct but falls back
# to expanding on the fly until the horizon is rebuilt.
# CALENDAR_OCCURRENCE_HORIZON_FUTURE_MONTHS=
# How often the background queue is drained, in milliseconds (default 5000). Each pass
# rebuilds at most 25 events; lower it if an edit should become fast sooner after saving.
# CALENDAR_OCCURRENCE_TICK_MS=

# ── Experimental ──────────────────────────────────────────────────────────────
# Div-based email renderer (replaces iframe). Set to true on a dev instance to
# test before the iframe path is removed. Do not enable in production until the
# full email test matrix has been validated.
VITE_EMAIL_DIV_RENDER=false

# Set to 0 to make this installation offer and accept no provider authorization: no Google, no Microsoft
# mailbox, no device method, no contacts connector. Unset means enabled. Note what it does not yet cover:
# a manual sync or the scheduled refresh for collections pulled earlier still calls the provider, so this
# switch is not a guarantee that no outbound provider call happens. The per-provider and per-method
# switches in Settings -> Integrations narrow a configured installation further.
PROVIDER_INTEGRATIONS_ENABLED=1
