# Environment — never commit real secrets
.env
*.env.local

# Local docker compose overrides (e.g. temporary LOG_LEVEL=debug for a soak) — never committed
docker-compose.override.yml

# Dependencies
node_modules/

# Build output
backend/dist/
frontend/dist/
frontend/.vite/
frontend/packages/release/

# TLS certs (generated locally or via Let's Encrypt)
certs/

# Logs
*.log
npm-debug.log*

# Local Playwright browser cache (installed into the workspace when ~/.cache is
# not writable); never committed.
.pw-browsers/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

.superpowers/
.hermes/
output/
frontend/artifacts/
artifacts/

# Lokalny zapis digestow do rollbacku (nie commitowac)
.rollback/

# Local Android/JDK toolchain used for on-device build verification — never committed
.toolchain/

# pnpm local store + workspace files (project uses npm via package-lock.json)
.pnpm-store/
pnpm-lock.yaml
pnpm-workspace.yaml

# Local git bundles/backups (not part of the project)
# NOTE: tsconfig.strict.json is intentionally tracked - it is the strict reference config.
.backup/
