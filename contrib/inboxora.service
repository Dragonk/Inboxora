# Inboxora — systemd service for native installs
#
# Setup:
#   1. Copy to /etc/systemd/system/inboxora.service
#   2. Edit WorkingDirectory and EnvironmentFile to match your install path
#   3. Edit User to match the user who owns the files
#   4. sudo systemctl daemon-reload
#      sudo systemctl enable --now inboxora

[Unit]
Description=Inboxora backend
Documentation=https://github.com/Dragonk/Inboxora
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/inboxora/backend
EnvironmentFile=/opt/inboxora/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=inboxora

# Harden the service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/inboxora

[Install]
WantedBy=multi-user.target
